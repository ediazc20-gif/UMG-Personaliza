<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="defs_umg_personaliza"
                  targetNamespace="http://umg.edu.gt/personaliza">
  <bpmn:collaboration id="colab_1">
    <bpmn:participant id="pool_umg" name="UMG Personaliza — Proceso de compra y entrega" processRef="proc_compra" />
  </bpmn:collaboration>
  <bpmn:process id="proc_compra" isExecutable="false">
    <bpmn:laneSet id="laneset_1">
        <bpmn:lane id="lane_comprador" name="Comprador">
          <bpmn:flowNodeRef>ev_ini</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_pers</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_cart</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_area</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gw_pago</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_tarj</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="lane_sistema" name="Sistema (backend)">
          <bpmn:flowNodeRef>t_valid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gw_val</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ev_rech</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_orden</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_pdf</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_notif</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="lane_taller" name="Taller / Supervisor">
          <bpmn:flowNodeRef>t_elab</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gw_ent</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="lane_repartidor" name="Repartidor">
          <bpmn:flowNodeRef>t_ruta</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_punto</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_scan</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_ver</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gw_loc</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_firma</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ev_ok</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>t_noenc</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="ev_ini" name="Comprador con sesion iniciada">
        <bpmn:outgoing>f01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="t_pers" name="Elegir articulo y personalizar Lado A / Lado B">
        <bpmn:incoming>f01</bpmn:incoming>
        <bpmn:outgoing>f02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_cart" name="Agregar al carrito y ajustar cantidades">
        <bpmn:incoming>f02</bpmn:incoming>
        <bpmn:outgoing>f03</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_area" name="Elegir area de entrega del campus">
        <bpmn:incoming>f03</bpmn:incoming>
        <bpmn:outgoing>f04</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="gw_pago" name="Metodo de pago?">
        <bpmn:incoming>f04</bpmn:incoming>
        <bpmn:outgoing>f05</bpmn:outgoing>
        <bpmn:outgoing>f06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="t_tarj" name="Ingresar datos de tarjeta (Recurrente)">
        <bpmn:incoming>f05</bpmn:incoming>
        <bpmn:outgoing>f07</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_conf" name="Confirmar checkout con reCAPTCHA">
        <bpmn:incoming>f06</bpmn:incoming>
        <bpmn:incoming>f07</bpmn:incoming>
        <bpmn:outgoing>f08</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_valid" name="Validar reCAPTCHA y disponibilidad">
        <bpmn:incoming>f08</bpmn:incoming>
        <bpmn:outgoing>f09</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="gw_val" name="Validacion correcta?">
        <bpmn:incoming>f09</bpmn:incoming>
        <bpmn:outgoing>f10</bpmn:outgoing>
        <bpmn:outgoing>f11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="ev_rech" name="Checkout rechazado">
        <bpmn:incoming>f10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="t_orden" name="Registrar orden UMG-XXXX  [recibida]">
        <bpmn:incoming>f11</bpmn:incoming>
        <bpmn:outgoing>f12</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_pdf" name="Emitir constancia PDF con codigo QR">
        <bpmn:incoming>f12</bpmn:incoming>
        <bpmn:outgoing>f13</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_notif" name="Notificar y publicar tracking (WebSocket)">
        <bpmn:incoming>f13</bpmn:incoming>
        <bpmn:outgoing>f14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_elab" name="Elaborar producto  [en_elaboracion]">
        <bpmn:incoming>f14</bpmn:incoming>
        <bpmn:outgoing>f15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="gw_ent" name="Como se entrega?">
        <bpmn:incoming>f15</bpmn:incoming>
        <bpmn:outgoing>f16</bpmn:outgoing>
        <bpmn:outgoing>f17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="t_ruta" name="Salir a ruta  [en_ruta]">
        <bpmn:incoming>f16</bpmn:incoming>
        <bpmn:incoming>f25</bpmn:incoming>
        <bpmn:outgoing>f18</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_punto" name="Dejar en punto  [lista_entrega]">
        <bpmn:incoming>f17</bpmn:incoming>
        <bpmn:outgoing>f19</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_scan" name="Escanear QR de la constancia">
        <bpmn:incoming>f18</bpmn:incoming>
        <bpmn:incoming>f19</bpmn:incoming>
        <bpmn:outgoing>f20</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="t_ver" name="Verificar estado de la orden">
        <bpmn:incoming>f20</bpmn:incoming>
        <bpmn:outgoing>f21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="gw_loc" name="Comprador localizado?">
        <bpmn:incoming>f21</bpmn:incoming>
        <bpmn:outgoing>f22</bpmn:outgoing>
        <bpmn:outgoing>f24</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="t_firma" name="Registrar firma, foto y pago en efectivo">
        <bpmn:incoming>f22</bpmn:incoming>
        <bpmn:outgoing>f23</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ev_ok" name="Orden entregada">
        <bpmn:incoming>f23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="t_noenc" name="Registrar no encontrado  [no_encontrado]">
        <bpmn:incoming>f24</bpmn:incoming>
        <bpmn:outgoing>f25</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="f01" sourceRef="ev_ini" targetRef="t_pers" />
      <bpmn:sequenceFlow id="f02" sourceRef="t_pers" targetRef="t_cart" />
      <bpmn:sequenceFlow id="f03" sourceRef="t_cart" targetRef="t_area" />
      <bpmn:sequenceFlow id="f04" sourceRef="t_area" targetRef="gw_pago" />
      <bpmn:sequenceFlow id="f05" name="Tarjeta" sourceRef="gw_pago" targetRef="t_tarj" />
      <bpmn:sequenceFlow id="f06" name="Efectivo contra entrega" sourceRef="gw_pago" targetRef="t_conf" />
      <bpmn:sequenceFlow id="f07" sourceRef="t_tarj" targetRef="t_conf" />
      <bpmn:sequenceFlow id="f08" sourceRef="t_conf" targetRef="t_valid" />
      <bpmn:sequenceFlow id="f09" sourceRef="t_valid" targetRef="gw_val" />
      <bpmn:sequenceFlow id="f10" name="No" sourceRef="gw_val" targetRef="ev_rech" />
      <bpmn:sequenceFlow id="f11" name="Si" sourceRef="gw_val" targetRef="t_orden" />
      <bpmn:sequenceFlow id="f12" sourceRef="t_orden" targetRef="t_pdf" />
      <bpmn:sequenceFlow id="f13" sourceRef="t_pdf" targetRef="t_notif" />
      <bpmn:sequenceFlow id="f14" sourceRef="t_notif" targetRef="t_elab" />
      <bpmn:sequenceFlow id="f15" sourceRef="t_elab" targetRef="gw_ent" />
      <bpmn:sequenceFlow id="f16" name="Reparto a domicilio" sourceRef="gw_ent" targetRef="t_ruta" />
      <bpmn:sequenceFlow id="f17" name="Retiro en punto" sourceRef="gw_ent" targetRef="t_punto" />
      <bpmn:sequenceFlow id="f18" sourceRef="t_ruta" targetRef="t_scan" />
      <bpmn:sequenceFlow id="f19" sourceRef="t_punto" targetRef="t_scan" />
      <bpmn:sequenceFlow id="f20" sourceRef="t_scan" targetRef="t_ver" />
      <bpmn:sequenceFlow id="f21" sourceRef="t_ver" targetRef="gw_loc" />
      <bpmn:sequenceFlow id="f22" name="Si" sourceRef="gw_loc" targetRef="t_firma" />
      <bpmn:sequenceFlow id="f23" sourceRef="t_firma" targetRef="ev_ok" />
      <bpmn:sequenceFlow id="f24" name="No" sourceRef="gw_loc" targetRef="t_noenc" />
      <bpmn:sequenceFlow id="f25" name="Reintento de entrega" sourceRef="t_noenc" targetRef="t_ruta" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag_1">
    <bpmndi:BPMNPlane id="plane_1" bpmnElement="colab_1">
      <bpmndi:BPMNShape id="di_pool_umg" bpmnElement="pool_umg" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="3386" height="800" />
      </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="di_lane_comprador" bpmnElement="lane_comprador" isHorizontal="true">
