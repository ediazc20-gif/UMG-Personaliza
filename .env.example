# Copiar a .env y completar secretos (no subir .env a Git).

MYSQL_ROOT_PASSWORD=cambiar_por_secreto_fuerte

# JWT (obligatorio — docker compose falla sin JWT_SECRET)
JWT_SECRET=cambiar_por_secreto_largo_aleatorio
JWT_ISSUER=umg_personaliza
JWT_AUDIENCE=umg_personaliza_frontend
JWT_EXPIRES=15m
REFRESH_EXPIRES=7d

# DB dentro de Docker Compose (host = mysql)
DB_NAME=umg_personaliza_db

LOCAL_DB_HOST=mysql
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=cambiar_igual_que_mysql_root
LOCAL_DB_NAME=umg_personaliza_db

CENTRALP_DB_HOST=mysql
CENTRALP_DB_PORT=3306
CENTRALP_DB_USER=root
CENTRALP_DB_PASSWORD=cambiar_igual_que_mysql_root
CENTRALP_DB_NAME=umg_personaliza_db

DB_TZ=-06:00

# URLs publicas (HTTP local → cookies sin Secure)
PUBLIC_URL=http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8081
COOKIE_SECURE=false

# Gmail (obligatorio para reset password / correos — sin fallback en codigo)
GMAIL_USER=
GMAIL_PASS=

# Opcional: secreto dedicado para QR de credenciales (si no, usa JWT_SECRET)
CREDENTIAL_QR_SECRET=

# Firma PDF remota (desactivar en local)
SIGNING_SERVICE_URL=
SIGNING_SERVICE_API_KEY=
SIGNING_REQUIRED=false
SIGNING_REASON=Firma credencial UMG Personaliza
SIGNING_LOCATION=Guatemala
SIGNING_TIMEOUT_MS=30000

# reCAPTCHA v2 — en produccion define keys y RECAPTCHA_SKIP=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SKIP=true
